{
  "app": "matharium",
  "version": 1,
  "mode": "3d",
  "view": {
    "ox": 0,
    "oy": 0,
    "sx": 50,
    "sy": 50
  },
  "settings": {
    "grid": true,
    "axes": true,
    "labels": true,
    "snap": true,
    "digits": 2,
    "range3d": 6
  },
  "objects": [
    {
      "id": "t0",
      "name": "r",
      "input": "r = 2",
      "color": "#3282F6",
      "visible": true,
      "slider": {
        "min": 0.5,
        "max": 4,
        "step": 0.1
      }
    },
    {
      "id": "t1",
      "name": "c",
      "input": "c = 0.3",
      "color": "#3282F6",
      "visible": true,
      "slider": {
        "min": 0.05,
        "max": 1,
        "step": 0.05
      }
    },
    {
      "id": "t2",
      "name": "s",
      "input": "s = 3",
      "color": "#3282F6",
      "visible": true,
      "slider": {
        "min": 0,
        "max": 18.8,
        "step": 0.05
      }
    },
    {
      "id": "t3",
      "name": "h",
      "input": "h = Curve(r cos(t), r sin(t), c t, t, 0, 6pi)",
      "color": "#E45B45",
      "visible": true
    },
    {
      "id": "t4",
      "name": "P",
      "input": "P = (r cos(s), r sin(s), c s)",
      "color": "#3282F6",
      "visible": true
    }
  ],
  "sheet": {},
  "table": {
    "ids": [],
    "start": -5,
    "end": 5,
    "step": 1
  },
  "meta": {
    "title": {
      "en": "Helix",
      "ar": "الحلزون"
    },
    "description": {
      "en": "A space curve (r cos t, r sin t, c t). Slide s to move a point along it.",
      "ar": "منحنى فراغي (r cos t, r sin t, c t). حرّك s لتنتقل نقطة عليه."
    }
  }
}
