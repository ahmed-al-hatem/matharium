{
  "app": "matharium",
  "version": 1,
  "mode": "graphing",
  "view": {
    "ox": 0,
    "oy": 0,
    "sx": 60,
    "sy": 60
  },
  "settings": {
    "grid": true,
    "axes": true,
    "labels": true,
    "snap": true,
    "digits": 2,
    "range3d": 6
  },
  "objects": [
    {
      "id": "t0",
      "name": "f",
      "input": "f(x) = x^3 / 3 - x",
      "color": "#E45B45",
      "visible": true
    },
    {
      "id": "t1",
      "name": "a",
      "input": "a = 1.5",
      "color": "#3282F6",
      "visible": true,
      "slider": {
        "min": -3,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "id": "t2",
      "name": "P",
      "input": "P = (a, f(a))",
      "color": "#3282F6",
      "visible": true
    },
    {
      "id": "t3",
      "name": "g",
      "input": "g = Tangent(a, f)",
      "color": "#6DC4AA",
      "visible": true,
      "showLabel": false
    },
    {
      "id": "t4",
      "name": "m",
      "input": "m = f'(a)",
      "color": "#6DC4AA",
      "visible": true
    },
    {
      "id": "t5",
      "name": "text1",
      "input": "text1 = Text(\"$m = f'(a)$\", (24, 64), \"screen\")",
      "color": "#DCDCDC",
      "visible": true
    }
  ],
  "sheet": {},
  "table": {
    "ids": [],
    "start": -5,
    "end": 5,
    "step": 1
  },
  "meta": {
    "title": {
      "en": "Derivative as the slope of the tangent",
      "ar": "المشتقة كميل المماس"
    },
    "description": {
      "en": "Move a along the curve: the tangent line turns and its slope m equals f'(a).",
      "ar": "حرّك a على المنحنى: يدور المماس ويساوي ميله m القيمة f'(a)."
    }
  }
}
