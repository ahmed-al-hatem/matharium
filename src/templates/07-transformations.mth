{
  "app": "matharium",
  "version": 1,
  "mode": "graphing",
  "view": {
    "ox": 0,
    "oy": 0,
    "sx": 50,
    "sy": 50
  },
  "settings": {
    "grid": true,
    "axes": true,
    "labels": true,
    "snap": true,
    "digits": 2,
    "range3d": 6
  },
  "objects": [
    {
      "id": "t0",
      "name": "f",
      "input": "f(x) = x^2",
      "color": "#DCDCDC",
      "visible": true,
      "lineWidth": 1.5
    },
    {
      "id": "t1",
      "name": "a",
      "input": "a = 1",
      "color": "#3282F6",
      "visible": true,
      "slider": {
        "min": -3,
        "max": 3,
        "step": 0.1
      }
    },
    {
      "id": "t2",
      "name": "h",
      "input": "h = 0",
      "color": "#3282F6",
      "visible": true,
      "slider": {
        "min": -5,
        "max": 5,
        "step": 0.1
      }
    },
    {
      "id": "t3",
      "name": "k",
      "input": "k = 0",
      "color": "#3282F6",
      "visible": true,
      "slider": {
        "min": -5,
        "max": 5,
        "step": 0.1
      }
    },
    {
      "id": "t4",
      "name": "g",
      "input": "g(x) = a f(x - h) + k",
      "color": "#E45B45",
      "visible": true
    },
    {
      "id": "t5",
      "name": "text1",
      "input": "text1 = Text(\"$g(x) = a\\,f(x-h) + k$\", (24, 64), \"screen\")",
      "color": "#DCDCDC",
      "visible": true
    }
  ],
  "sheet": {},
  "table": {
    "ids": [],
    "start": -5,
    "end": 5,
    "step": 1
  },
  "meta": {
    "title": {
      "en": "Transformations of functions",
      "ar": "تحويلات الدوال"
    },
    "description": {
      "en": "Stretch, reflect and shift f(x) = x² with a, h and k. Redefine f to transform any function.",
      "ar": "مدّد واعكس وأزِح f(x) = x² بالمعاملات a وh وk. أعد تعريف f لتحويل أي دالة."
    }
  }
}
