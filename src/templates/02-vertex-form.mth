{
  "app": "matharium",
  "version": 1,
  "mode": "graphing",
  "view": {
    "ox": 0,
    "oy": 0,
    "sx": 50,
    "sy": 50
  },
  "settings": {
    "grid": true,
    "axes": true,
    "labels": true,
    "snap": true,
    "digits": 2,
    "range3d": 6
  },
  "objects": [
    {
      "id": "t0",
      "name": "a",
      "input": "a = 1",
      "color": "#3282F6",
      "visible": true,
      "slider": {
        "min": -3,
        "max": 3,
        "step": 0.1
      }
    },
    {
      "id": "t1",
      "name": "h",
      "input": "h = 2",
      "color": "#3282F6",
      "visible": true,
      "slider": {
        "min": -5,
        "max": 5,
        "step": 0.1
      }
    },
    {
      "id": "t2",
      "name": "k",
      "input": "k = -1",
      "color": "#3282F6",
      "visible": true,
      "slider": {
        "min": -5,
        "max": 5,
        "step": 0.1
      }
    },
    {
      "id": "t3",
      "name": "f",
      "input": "f(x) = a * (x - h)^2 + k",
      "color": "#E45B45",
      "visible": true
    },
    {
      "id": "t4",
      "name": "V",
      "input": "V = (h, k)",
      "color": "#3282F6",
      "visible": true
    },
    {
      "id": "t5",
      "name": "eq1",
      "input": "eq1: x = h",
      "color": "#DCDCDC",
      "visible": true,
      "lineWidth": 1
    },
    {
      "id": "t6",
      "name": "text1",
      "input": "text1 = Text(\"$f(x) = a(x-h)^2 + k$\", (24, 64), \"screen\")",
      "color": "#DCDCDC",
      "visible": true
    }
  ],
  "sheet": {},
  "table": {
    "ids": [],
    "start": -5,
    "end": 5,
    "step": 1
  },
  "meta": {
    "title": {
      "en": "Parabola in vertex form",
      "ar": "الصيغة الرأسية للقطع المكافئ"
    },
    "description": {
      "en": "The vertex (h, k), the axis of symmetry x = h and the opening factor a.",
      "ar": "الرأس (h, k) ومحور التماثل x = h ومعامل الانفتاح a."
    }
  }
}
